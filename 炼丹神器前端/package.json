{
  "name": "liandan-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests",
    "api:types": "openapi-typescript docs/api/openapi.json -o src/types/api-schema.d.ts",
    "check:api": "node scripts/check-api-contract.mjs"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "pinia": "4.1.0",
    "element-plus": "2.14.7",
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.21.0",
    "echarts": "6.1.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-vue": "6.0.10",
    "vue-tsc": "3.3.13",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "vitest": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
