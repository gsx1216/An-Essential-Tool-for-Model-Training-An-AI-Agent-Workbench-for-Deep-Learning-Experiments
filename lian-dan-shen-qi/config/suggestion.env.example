# 示例配置；不会自动合并进 config/.env。默认不调用模型。
SUGGESTION_WORKER_ENABLED=false
SUGGESTION_MODEL_NAME=deepseek-flash
SUGGESTION_MAX_CALLS=8
SUGGESTION_MAX_INPUT_TOKENS=49152
SUGGESTION_MAX_OUTPUT_TOKENS=4096
SUGGESTION_MODEL_TIMEOUT_SECONDS=60
SUGGESTION_STEP_TIMEOUT_SECONDS=600
SUGGESTION_LEASE_SECONDS=90
SUGGESTION_HEARTBEAT_SECONDS=15
# 公开资料总开关仍使用既有 RESEARCH_ENABLED；本人开关通过 API 单独设置。
