# 仅保存在后端；将值填写在本机 config/.env 或服务器环境变量中。
# 含 #、空格等特殊字符时，可以给密码加引号。
MYSQL_PASSWORD=

# 聊天输入预算（含工具）；48K = 49,152。当前按 UTF-8 字节保守估算，非精确 token。
# 环境变量优先；修改后重启 API 进程。输出上限仍为 4,096 token，独立于输入预算。
CHAT_MAX_INPUT_TOKENS=49152
CHAT_MODEL_REQUEST_TOKENS=49152
CHAT_COMPACT_AT_TOKENS=39321

# 服务器项目目录下的可见产物目录。新运行冻结此值；已有运行使用原快照或默认值。
RUNNER_OUTPUT_DIRECTORY=training_outputs

# Redis 连接由部署者配置，不通过普通用户接口传入。密码特殊字符需 URL 编码。
# 不要把实际密码写入此示例文件；本机现有 Redis 如需认证，请在实际 .env 配置。
REDIS_URL=redis://127.0.0.1:6379/0
# 个人 Skill 沿用此连接的认证/TLS，但固定使用 1 号库，按用户隔离、不设 TTL。
# MySQL 保存持久记录；首次读取正文后缓存，删除个人 Skill 时同步删除对应缓存。
AGENT_EVENT_PREFIX=experiment_assistant

# 聊天上下文缓存，与事件 Stream 使用不同键；MySQL 始终及时保存原文。
# 缓存正文使用现有主密钥派生专用密钥加密；过期/故障时自动读取 MySQL。
CHAT_CONTEXT_CACHE_ENABLED=true
CHAT_CONTEXT_CACHE_PREFIX=experiment_assistant
CHAT_CONTEXT_CACHE_TTL_SECONDS=604800
CHAT_CONTEXT_CACHE_MAX_ENTRY_BYTES=1048576
CHAT_CONTEXT_CACHE_FAILURE_BACKOFF_SECONDS=10

# 独立分析 Worker 默认关闭；用户也需通过本人接口明确启用后台分析。
# 只读取冻结报告；不联网检索论文、不修改代码、不启动训练。
ANALYSIS_WORKER_ENABLED=false
ANALYSIS_MODEL_NAME=deepseek-flash
ANALYSIS_LEASE_SECONDS=90
ANALYSIS_HEARTBEAT_SECONDS=15
ANALYSIS_MODEL_TIMEOUT_SECONDS=120
ANALYSIS_STEP_TIMEOUT_SECONDS=180
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_MAX_INPUT_TOKENS=49152
ANALYSIS_MAX_OUTPUT_TOKENS=2048

# 模型请求默认直连，避免继承失效的桌面代理。确实需要环境代理时显式设为 true。
MODEL_TRUST_ENV=false
